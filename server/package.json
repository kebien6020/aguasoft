{
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "babel src -d dist -x .ts,.js --delete-dir-on-start",
    "dev": "node --import tsx --watch --watch-path=src src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "npm run build && node ./dist/scripts/migrate.js",
    "start": "node dist/clustered.js",
    "start-dev": "node --import tsx src/index.ts",
    "test": "tsx test.ts",
    "test:junit": "tsx test.ts --test-reporter=junit --test-reporter-destination=test-report.xml",
    "test:update-snapshots": "tsx test.ts --test-update-snapshots",
    "test:only": "tsx test.ts --test-only",
    "watch-run": "node --watch dist/index.js",
    "watch-build": "npm run build -- -w"
  },
  "dependencies": {
    "@sequelize/core": "^7.0.0-alpha.48",
    "@sequelize/sqlite3": "^7.0.0-alpha.48",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "body-parser": "^2.3.0",
    "buffer": "^6.0.3",
    "date-fns": "^4.4.0",
    "debug": "^4.4.3",
    "express": "npm:ultimate-express",
    "express-jwt": "^8.5.1",
    "express-session": "^1.19.0",
    "jwks-rsa": "^4.1.0",
    "qs": "^6.16.0",
    "sequelize-cli": "^6.6.5",
    "ultimate-express": "^2.2.1",
    "umzug": "^3.8.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "$comment.override-uuid": "Overridden because sequelize@6.37.8 requests uuid@8 which is now reporting for vulns. 11.1.1 is the newest version still using CommonJS",
  "$comment.override-sqlite3": "Overridden because sequelize requests an older sqlite3, remove when sequelize v7 is released",
  "overrides": {
    "uuid": "^11.1.1",
    "sqlite3": "6.0.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "sqlite3@6.0.1": true
  }
}
