{
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "babel src -d dist -x .ts,.js --delete-dir-on-start",
    "dev": "node --import tsx --watch --watch-path=src src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "npm run build && sequelize db:migrate",
    "start": "node dist/clustered.js",
    "start-dev": "node --import tsx src/index.ts",
    "test": "tsx test.ts",
    "test:junit": "tsx test.ts --test-reporter=junit --test-reporter-destination=test-report.xml",
    "test:update-snapshots": "tsx test.ts --test-update-snapshots",
    "test:only": "tsx test.ts --test-only",
    "watch-run": "node --watch dist/index.js",
    "watch-build": "npm run build -- -w"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "body-parser": "^2.2.2",
    "buffer": "^6.0.3",
    "date-fns": "^4.2.1",
    "debug": "^4.4.3",
    "express": "npm:ultimate-express",
    "express-jwt": "^8.5.1",
    "express-session": "^1.19.0",
    "jwks-rsa": "^4.0.1",
    "qs": "^6.15.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "ultimate-express": "^2.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "glob": "^13.0.6",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
